# 构建时 / 本地工具变量，不会作为 Worker 机密注入。
# 本地复制为 .env。生产写在 Cloudflare Builds 的构建变量里。

# --- 部署必填（cloudflare.config.ts 读取；本地开发可留空使用占位符） ---
# 注意：cloudflare.config.ts 只读取真实的环境变量，不读取 .env 文件，
# 所以这些值需要写在 Cloudflare Builds 的构建变量里。
WORKER_NAME=my-blog
QUEUE_NAME=blog-queue
DOMAIN=blog.example.com
D1_DATABASE_ID=your-d1-database-id
KV_NAMESPACE_ID=your-kv-namespace-id
BUCKET_NAME=your-r2-bucket-name
# --- 域名绑定模式（可选，默认使用 Custom Domain 自定义域）---
# 若改用 Workers Routes 路由模式（如已有 DNS 代理记录），设为 1 即可；ZONE_NAME 默认从 DOMAIN 自动推导
# ROUTE=1
# ZONE_NAME=example.com

# --- 可选：构建时注入前端 ---
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# VITE_UMAMI_WEBSITE_ID=your-umami-website-id

# --- 本地 Drizzle（db:studio、db:push），不进 Worker ---
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_DATABASE_ID=your-d1-database-id
CLOUDFLARE_D1_TOKEN=your-d1-api-token

# --- Fork 原有主题 / 身份（可选；前后台固定保留原 default 样式） ---
# VITE_BLOG_NAME=blog
# VITE_BLOG_TITLE=Yasin's Blog
# VITE_BLOG_AUTHOR=Yasin
# VITE_BLOG_DESCRIPTION=一些教程，吉他谱和个人的碎碎念
# VITE_BLOG_GITHUB=https://github.com/yasingf
# VITE_BLOG_EMAIL=yasingfls@outlook.com
# VITE_ENABLE_GUITAR_TABS=true
# VITE_DEFAULT_HOME_IMAGE=
# VITE_DEFAULT_GLOBAL_IMAGE=
# VITE_DEFAULT_LIGHT_OPACITY=0.15
# VITE_DEFAULT_DARK_OPACITY=0.1
# VITE_DEFAULT_BACKDROP_BLUR=8
# VITE_DEFAULT_TRANSITION_DURATION=600

# Optional: public GoatCounter tracking and server-side statistics
# VITE_GOATCOUNTER_SITE=https://your-code.goatcounter.com
# GOATCOUNTER_SITE=https://your-code.goatcounter.com
# Store GOATCOUNTER_API_TOKEN as a Worker secret, never VITE_*
